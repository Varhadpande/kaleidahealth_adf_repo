{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfkaleidahealth"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kaleidahealthkv.vault.azure.net/"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://kaleidahealthstorage.dfs.core.windows.net/"
		},
		"ls_azuresqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kaleidahealthserver.database.windows.net"
		},
		"ls_azuresqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "kaleidahealthsqldb"
		},
		"ls_azuresqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "varhadpande"
		},
		"ls_postgresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-plain-tree-bd8vervc-pooler.c-8.us-east-2.aws.neon.tech"
		},
		"ls_postgresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgresql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1106-192357-9xwrk7ls"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfkaleidahealth_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_azuresqldb_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_server')]"
					},
					"ls_azuresqldb_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_database')]"
					},
					"ls_azuresqldb_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_userName')]"
					},
					"ls_postgresql_properties_typeProperties_server": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_server')]"
					},
					"ls_postgresql_properties_typeProperties_database": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_database')]"
					},
					"ls_postgresql_properties_typeProperties_username": {
						"value": "[parameters('ls_postgresql_properties_typeProperties_username')]"
					},
					"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}